rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function hasUserProfile() {
      return isSignedIn() && exists(userPath());
    }

    function userProfile() {
      return get(userPath()).data;
    }

    function isActiveUser() {
      return hasUserProfile()
        && userProfile().activo != false
        && userProfile().enabled != false;
    }

    function isAdmin() {
      return isActiveUser()
        && (
          userProfile().rol == "Administrador"
          || (
            userProfile().permisos is list
            && userProfile().permisos.hasAny([
              "Acceso total al sistema"
            ])
          )
        );
    }

    function hasPermission(permission) {
      return isActiveUser()
        && (
          isAdmin()
          || (
            userProfile().permisos is list
            && userProfile().permisos.hasAny([permission])
          )
        );
    }

    function hasAnyPermission(permissions) {
      return isActiveUser()
        && (
          isAdmin()
          || (
            userProfile().permisos is list
            && userProfile().permisos.hasAny(permissions)
          )
        );
    }

    function canTickets() {
      return hasAnyPermission([
        "Ver y actualizar tickets asignados"
      ]);
    }

    function canSales() {
      return hasAnyPermission([
        "Registrar ventas y cobros"
      ]);
    }

    function canCash() {
      return hasAnyPermission([
        "Abrir y cerrar corte de caja"
      ]);
    }

    function canCredits() {
      return hasAnyPermission([
        "Aprobar créditos y descuentos"
      ]);
    }

    function canProducts() {
      return hasAnyPermission([
        "Editar catálogo de productos"
      ]);
    }

    function canReports() {
      return hasAnyPermission([
        "Ver reportes financieros"
      ]);
    }

    function canSecurity() {
      return hasAnyPermission([
        "Gestionar usuarios y roles"
      ]);
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function legacyUserPath(legacyId) {
      return /databases/$(database)/documents/usuarios/$(legacyId);
    }

    function isOwnLegacyProfile(legacyId) {
      return isSignedIn()
        && legacyId != request.auth.uid
        && exists(legacyUserPath(legacyId))
        && get(legacyUserPath(legacyId)).data.email == authEmail();
    }

    function validSelfLegacyMigration(userId) {
      return isSignedIn()
        && userId == request.auth.uid
        && request.resource.data.migradoDesde is string
        && isOwnLegacyProfile(request.resource.data.migradoDesde)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.email == authEmail()
        && request.resource.data
          .diff(
            get(
              legacyUserPath(request.resource.data.migradoDesde)
            ).data
          )
          .affectedKeys()
          .hasOnly([
            "id",
            "uid",
            "authUid",
            "email",
            "authPendiente",
            "migradoDesde",
            "actualizadoEn",
            "actualizadoPor"
          ]);
    }

    function validSelfLegacyDelete(userId) {
      let targetPath = /databases/$(database)/documents/usuarios/$(request.auth.uid);

      return isSignedIn()
        && userId != request.auth.uid
        && resource.data.email == authEmail()
        && existsAfter(targetPath)
        && getAfter(targetPath).data.migradoDesde == userId
        && getAfter(targetPath).data.uid == request.auth.uid
        && getAfter(targetPath).data.authUid == request.auth.uid
        && getAfter(targetPath).data.email == authEmail()
        && getAfter(targetPath).data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "id",
            "uid",
            "authUid",
            "email",
            "authPendiente",
            "migradoDesde",
            "actualizadoEn",
            "actualizadoPor"
          ]);
    }

    function isValidPublicToken(token) {
      return token.matches('^[a-fA-F0-9]{48}$');
    }

    /* =====================================
       PRESUPUESTOS PÚBLICOS
       - lectura pública por token
       - respuesta pública de un solo uso
       - gestión interna autenticada
    ===================================== */

    match /presupuestos_publicos/{token} {
      allow get: if isValidPublicToken(token);

      allow list, create, delete: if
        hasAnyPermission([
          "Registrar ventas y cobros",
          "Ver y actualizar tickets asignados"
        ]);

      allow update: if
        hasAnyPermission([
          "Registrar ventas y cobros",
          "Ver y actualizar tickets asignados"
        ])
        || isValidPublicResponse();

      function isValidPublicResponse() {
        return isValidPublicToken(token)
          && resource.data.activo == true
          && resource.data.respuesta == null
          && resource.data.venceEn is timestamp
          && request.time <= resource.data.venceEn
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "respuesta",
            "estado",
            "respondidoEn",
            "actualizadoEn"
          ])
          && request.resource.data.respuesta in ["Aceptado", "Rechazado"]
          && request.resource.data.estado == request.resource.data.respuesta
          && request.resource.data.respondidoEn is string
          && request.resource.data.actualizadoEn is string;
      }
    }

    /* =====================================
       USUARIOS Y ROLES
    ===================================== */

    match /usuarios/{userId} {
      // El propio usuario puede leer su perfil por UID incluso si fue
      // desactivado, para que la app cierre la sesión con un mensaje claro.
      allow get: if isSignedIn() && request.auth.uid == userId;

      // Un usuario sin perfil UID solo puede consultar el perfil legacy
      // cuyo email coincide con el email verificado por Authentication.
      // Las reglas siguen sin permitir listar perfiles ajenos.
      allow list: if canSecurity()
        || (
          isSignedIn()
          && resource.data.email == authEmail()
        );

      allow get: if canSecurity();

      // Migración controlada: el usuario puede copiar SU perfil legacy a
      // /usuarios/{uid}, sin alterar rol, permisos, activo ni otros campos.
      allow create: if canSecurity()
        || validSelfLegacyMigration(userId);

      allow update: if canSecurity();

      // El documento legacy solo puede borrarse en el mismo batch en el que
      // queda creada una copia UID equivalente y vinculada por migradoDesde.
      allow delete: if canSecurity()
        || validSelfLegacyDelete(userId);
    }

    match /roles/{roleId} {
      allow read: if isActiveUser();
      allow write: if canSecurity();
    }

    /* =====================================
       OPERACIÓN TÉCNICA / COMERCIAL
    ===================================== */

    match /tickets/{ticketId} {
      // Caja/Facturación necesita leer un ticket puntual para cerrar
      // el circuito de cobro, sin habilitar el listado completo.
      allow get: if canTickets() || canSales() || canReports();
      allow list: if canTickets() || canReports();

      allow create, delete: if canTickets();

      allow update: if
        canTickets()
        || (
          canSales()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "estadoPago",
            "estadoCaja",
            "estadoFacturacion",
            "facturaId",
            "creditoId",
            "cajaPendienteId",
            "enviadoCajaEn",
            "cobradoEn",
            "actualizadoEn",
            "facturaAnulada",
            "facturaAnuladaId",
            "notaCreditoId",
            "historial"
          ])
        );
    }

    match /clientes/{clientId} {
      allow read: if hasAnyPermission([
        "Ver y actualizar tickets asignados",
        "Aprobar créditos y descuentos",
        "Registrar ventas y cobros",
        "Ver reportes financieros"
      ]);

      // Crear un cliente no debe otorgar cupo financiero por accidente.
      // Tickets/Ventas pueden registrar clientes, pero el límite distinto
      // de cero queda reservado al módulo Créditos.
      allow create: if
        canCredits()
        || (
          (canTickets() || canSales())
          && request.resource.data.limiteCredito == 0
          && request.resource.data.saldoAFavor == 0
        );

      // El límite de crédito solo puede cambiarlo Créditos.
      // Ventas puede mover saldo a favor por cobros/NC. Tickets solo puede
      // actualizar información no financiera del cliente.
      allow update: if
        canCredits()
        || (
          canSales()
          && !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny(["limiteCredito"])
        )
        || (
          canTickets()
          && !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny(["limiteCredito", "saldoAFavor"])
        );

      // Borrado físico: solo acceso total/administrador. El flujo normal
      // para el resto de los perfiles es archivar y conservar historial.
      allow delete: if isAdmin();
    }

    match /presupuestos/{budgetId} {
      allow read: if hasAnyPermission([
        "Ver y actualizar tickets asignados",
        "Registrar ventas y cobros",
        "Ver reportes financieros"
      ]);

      allow write: if hasAnyPermission([
        "Ver y actualizar tickets asignados",
        "Registrar ventas y cobros"
      ]);
    }

    match /creditos/{creditId} {
      allow get: if canCredits() || canSales() || canReports();
      allow list: if canCredits() || canReports();

      allow create, delete: if canCredits();

      allow update: if
        canCredits()
        || (
          canSales()
          && resource.data.origen == "Caja"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "estado",
            "saldo",
            "canceladoEn",
            "actualizadoEn",
            "actualizadoPor",
            "canceladaPorFacturaId",
            "historial"
          ])
        );
    }

    match /productos/{productId} {
      allow read: if isActiveUser();
      allow write: if canProducts() || canSales();
    }

    match /promociones/{promotionId} {
      allow read: if isActiveUser();
      allow write: if canProducts() || canSales();
    }

    match /crm/{opportunityId} {
      allow read, write: if canSales();
    }

    /* =====================================
       CAJA / FACTURACIÓN
    ===================================== */

    match /ventas/{saleId} {
      allow read: if canSales() || canReports();
      allow write: if canSales();
    }

    match /facturas/{invoiceId} {
      allow read: if canSales() || canCredits() || canReports();

      allow create, delete: if canSales();

      // El módulo Créditos puede sincronizar únicamente el estado financiero
      // de una factura originada por una financiación. No puede modificar
      // importes, cliente, ítems, numeración ni datos fiscales.
      allow update: if
        canSales()
        || (
          canCredits()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "estadoPago",
            "montoCobrado",
            "saldoPendiente",
            "pagadoEn",
            "actualizadoEn",
            "historial"
          ])
        );
    }

    match /caja_pendientes/{pendingId} {
      allow read: if hasAnyPermission([
        "Ver y actualizar tickets asignados",
        "Registrar ventas y cobros",
        "Abrir y cerrar corte de caja",
        "Ver reportes financieros"
      ]);

      // Ventas puede gestionar cualquier pendiente. Tickets solo puede crear
      // o retirar pendientes nacidos de un Ticket; no puede fabricar cobros
      // manuales ni alterar pendientes comerciales desde Firestore.
      allow create: if
        canSales()
        || (
          canTickets()
          && request.resource.data.origen == "Ticket"
          && request.resource.data.ticketId != null
        );

      allow update: if canSales();

      allow delete: if
        canSales()
        || (
          canTickets()
          && resource.data.origen == "Ticket"
          && resource.data.ticketId != null
        );
    }

    match /caja_cortes/{cutId} {
      allow read: if canCash() || canSales() || canReports();
      allow write: if canCash() || canSales();
    }

    match /cuenta_corriente/{movementId} {
      allow read: if canSales() || canCredits() || canReports();
      allow write: if canSales() || canCredits();
    }

    /* =====================================
       NEGOCIO / CONTADORES / CAJA ACTIVA
    ===================================== */

    match /negocio/configuracion {
      allow read: if isActiveUser();
      allow write: if canSecurity();
    }

    match /negocio/contadores {
      allow read: if isActiveUser();
      allow write: if hasAnyPermission([
        "Ver y actualizar tickets asignados",
        "Registrar ventas y cobros",
        "Aprobar créditos y descuentos"
      ]);
    }

    match /negocio/caja_activa {
      allow read: if hasAnyPermission([
        "Registrar ventas y cobros",
        "Abrir y cerrar corte de caja",
        "Aprobar créditos y descuentos",
        "Ver reportes financieros"
      ]);

      allow write: if hasAnyPermission([
        "Registrar ventas y cobros",
        "Abrir y cerrar corte de caja",
        "Aprobar créditos y descuentos"
      ]);
    }

    match /negocio/{documentId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    /* =====================================
       TODO LO NO DECLARADO: DENEGADO
    ===================================== */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
