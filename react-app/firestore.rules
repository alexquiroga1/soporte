rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function hasUserProfile() {
      return isSignedIn() && exists(userPath());
    }

    function userProfile() {
      return get(userPath()).data;
    }

    function isActiveUser() {
      return hasUserProfile()
        && userProfile().get("activo", true) != false
        && userProfile().get("enabled", true) != false;
    }

    /*
     * Compatibilidad real con perfiles legacy.
     *
     * La app normaliza el rol con trim + lowercase. Las reglas anteriores
     * comparaban valores exactos y un perfil como " Administrador " podía
     * verse como Admin en React pero quedar bloqueado por Firestore.
     */
    function isAdminRoleValue(value) {
      return value is string
        && value.matches('^ *[Aa][Dd][Mm][Ii][Nn][Ii][Ss][Tt][Rr][Aa][Dd][Oo][Rr] *$');
    }

    function storedPermissions() {
      return userProfile().get("permisos", []);
    }

    function isAdmin() {
      return isActiveUser()
        && (
          isAdminRoleValue(userProfile().get("rol", ""))
          || isAdminRoleValue(userProfile().get("role", ""))
          || (
            storedPermissions() is list
            && storedPermissions().hasAny([
              "Acceso total al sistema"
            ])
          )
        );
    }

    function hasPermission(permission) {
      return isActiveUser()
        && (
          isAdmin()
          || (
            storedPermissions() is list
            && storedPermissions().hasAny([permission])
          )
        );
    }

    function hasAnyPermission(permissions) {
      return isActiveUser()
        && (
          isAdmin()
          || (
            storedPermissions() is list
            && storedPermissions().hasAny(permissions)
          )
        );
    }

    function canTickets() {
      return hasAnyPermission([
        "Ver y actualizar tickets asignados"
      ]);
    }

    function canSales() {
      return hasAnyPermission([
        "Registrar ventas y cobros"
      ]);
    }

    function canCash() {
      return hasAnyPermission([
        "Abrir y cerrar corte de caja"
      ]);
    }

    function canCredits() {
      return hasAnyPermission([
        "Aprobar créditos y descuentos"
      ]);
    }

    function canProducts() {
      return hasAnyPermission([
        "Editar catálogo de productos"
      ]);
    }

    function canReports() {
      return hasAnyPermission([
        "Ver reportes financieros"
      ]);
    }

    function canSecurity() {
      return hasAnyPermission([
        "Gestionar usuarios y roles"
      ]);
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function legacyUserPath(legacyId) {
      return /databases/$(database)/documents/usuarios/$(legacyId);
    }

    function isOwnLegacyProfile(legacyId) {
      return isSignedIn()
        && legacyId != request.auth.uid
        && exists(legacyUserPath(legacyId))
        && get(legacyUserPath(legacyId)).data.email == authEmail();
    }

    function validSelfLegacyMigration(userId) {
      return isSignedIn()
        && userId == request.auth.uid
        && request.resource.data.migradoDesde is string
        && isOwnLegacyProfile(request.resource.data.migradoDesde)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.email == authEmail()
        && request.resource.data
          .diff(
            get(
              legacyUserPath(request.resource.data.migradoDesde)
            ).data
          )
          .affectedKeys()
          .hasOnly([
            "id",
            "uid",
            "authUid",
            "email",
            "authPendiente",
            "migradoDesde",
            "actualizadoEn",
            "actualizadoPor"
          ]);
    }

    function validSelfLegacyDelete(userId) {
      let targetPath = /databases/$(database)/documents/usuarios/$(request.auth.uid);

      return isSignedIn()
        && userId != request.auth.uid
        && resource.data.email == authEmail()
        && existsAfter(targetPath)
        && getAfter(targetPath).data.migradoDesde == userId
        && getAfter(targetPath).data.uid == request.auth.uid
        && getAfter(targetPath).data.authUid == request.auth.uid
        && getAfter(targetPath).data.email == authEmail()
        && getAfter(targetPath).data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "id",
            "uid",
            "authUid",
            "email",
            "authPendiente",
            "migradoDesde",
            "actualizadoEn",
            "actualizadoPor"
          ]);
    }

    function isValidPublicToken(token) {
      return token.matches('^[a-fA-F0-9]{48}$');
    }

    /* =====================================
       PRESUPUESTOS PÚBLICOS
       - lectura pública por token
       - respuesta pública de un solo uso
       - gestión interna autenticada
    ===================================== */

    match /presupuestos_publicos/{token} {
      allow get: if
        hasAnyPermission([
          "Registrar ventas y cobros",
          "Ver y actualizar tickets asignados"
        ])
        || (
          isValidPublicToken(token)
          && resource.data.activo == true
          && resource.data.venceEn is timestamp
          && request.time <= resource.data.venceEn
        );

      allow list, create: if
        hasAnyPermission([
          "Registrar ventas y cobros",
          "Ver y actualizar tickets asignados"
        ]);

      // Revocar un enlace se hace marcándolo inactivo. El borrado físico
      // queda reservado al administrador para conservar trazabilidad.
      allow delete: if isAdmin();

      allow update: if
        hasAnyPermission([
          "Registrar ventas y cobros",
          "Ver y actualizar tickets asignados"
        ])
        || isValidPublicResponse();

      function isValidPublicResponse() {
        return isValidPublicToken(token)
          && resource.data.activo == true
          && resource.data.respuesta == null
          && resource.data.venceEn is timestamp
          && request.time <= resource.data.venceEn
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "respuesta",
            "estado",
            "respondidoEn",
            "actualizadoEn"
          ])
          && request.resource.data.respuesta in ["Aceptado", "Rechazado"]
          && request.resource.data.estado == request.resource.data.respuesta
          && request.resource.data.respondidoEn is string
          && request.resource.data.actualizadoEn is string;
      }
    }

    /* =====================================
       USUARIOS Y ROLES
    ===================================== */

    match /usuarios/{userId} {
      // El propio usuario puede leer su perfil por UID incluso si fue
      // desactivado, para que la app cierre la sesión con un mensaje claro.
      allow get: if isSignedIn() && request.auth.uid == userId;

      // Un usuario sin perfil UID solo puede consultar el perfil legacy
      // cuyo email coincide con el email verificado por Authentication.
      // Las reglas siguen sin permitir listar perfiles ajenos.
      allow list: if canSecurity()
        || (
          isSignedIn()
          && resource.data.email == authEmail()
        );

      allow get: if canSecurity();

      // Migración controlada: el usuario puede copiar SU perfil legacy a
      // /usuarios/{uid}, sin alterar rol, permisos, activo ni otros campos.
      allow create: if canSecurity()
        || validSelfLegacyMigration(userId);

      allow update: if canSecurity();

      // El documento legacy solo puede borrarse en el mismo batch en el que
      // queda creada una copia UID equivalente y vinculada por migradoDesde.
      allow delete: if canSecurity()
        || validSelfLegacyDelete(userId);
    }

    match /roles/{roleId} {
      allow read: if isActiveUser();
      allow write: if canSecurity();
    }

    /* =====================================
       OPERACIÓN TÉCNICA / COMERCIAL
    ===================================== */

    match /tickets/{ticketId} {
      // Caja/Facturación necesita leer un ticket puntual para cerrar
      // el circuito de cobro, sin habilitar el listado completo.
      allow get: if canTickets() || canSales() || canReports();
      allow list: if canTickets() || canReports();

      allow create: if canTickets();

      // El borrado físico queda reservado a Auditoría interna / administrador.
      allow delete: if isAdmin();

      allow update: if
        (
          canTickets()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "estadoPago",
            "estadoFacturacion",
            "facturaId",
            "creditoId",
            "cobradoEn",
            "facturaAnulada",
            "facturaAnuladaId",
            "notaCreditoId",
            "inventarioAplicado",
            "inventarioAplicadoFacturaId"
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              "estadoCaja"
            ])
            || request.resource.data.estadoCaja in [
              "Pendiente",
              "No enviado",
              "Cancelado"
            ]
          )
        )
        || (
          canSales()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "estadoPago",
            "estadoCaja",
            "estadoFacturacion",
            "facturaId",
            "creditoId",
            "cajaPendienteId",
            "enviadoCajaEn",
            "cobradoEn",
            "actualizadoEn",
            "facturaAnulada",
            "facturaAnuladaId",
            "notaCreditoId",
            "inventarioAplicado",
            "inventarioAplicadoFacturaId",
            "historial"
          ])
        );
    }

    match /clientes/{clientId} {
      allow read: if hasAnyPermission([
        "Ver y actualizar tickets asignados",
        "Aprobar créditos y descuentos",
        "Registrar ventas y cobros",
        "Ver reportes financieros"
      ]);

      // Crear un cliente no debe otorgar cupo financiero por accidente.
      // Tickets/Ventas pueden registrar clientes, pero el límite distinto
      // de cero queda reservado al módulo Créditos.
      allow create: if
        canCredits()
        || (
          (canTickets() || canSales())
          && request.resource.data.limiteCredito == 0
          && request.resource.data.saldoAFavor == 0
        );

      // Archivar/restaurar es una acción de ciclo de vida sensible: la UI
      // exige Tickets + Ventas + Créditos y Firestore aplica la misma regla.
      // Fuera de ese cambio, Créditos puede gestionar la ficha completa;
      // Ventas no puede tocar el límite y Tickets no puede tocar finanzas.
      allow update: if
        (
          request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "archivado",
            "archivadoEn",
            "archivadoPor",
            "restauradoEn",
            "restauradoPor"
          ])
          && canTickets()
          && canSales()
          && canCredits()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "archivado",
            "archivadoEn",
            "archivadoPor",
            "restauradoEn",
            "restauradoPor",
            "actualizadoEn",
            "actualizadoPor"
          ])
        )
        || (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "archivado",
            "archivadoEn",
            "archivadoPor",
            "restauradoEn",
            "restauradoPor"
          ])
          && (
            canCredits()
            || (
              canSales()
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                "limiteCredito"
              ])
            )
            || (
              canTickets()
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                "limiteCredito",
                "saldoAFavor"
              ])
            )
          )
        );

      // Borrado físico: solo acceso total/administrador. El flujo normal
      // para el resto de los perfiles es archivar y conservar historial.
      allow delete: if isAdmin();
    }

    match /presupuestos/{budgetId} {
      allow read: if hasAnyPermission([
        "Ver y actualizar tickets asignados",
        "Registrar ventas y cobros",
        "Ver reportes financieros"
      ]);

      allow create, update: if hasAnyPermission([
        "Ver y actualizar tickets asignados",
        "Registrar ventas y cobros"
      ]);

      allow delete: if isAdmin();
    }

    match /creditos/{creditId} {
      allow get: if canCredits() || canSales() || canReports();
      allow list: if canCredits() || canReports();

      allow create: if canCredits();
      allow delete: if isAdmin();

      // Créditos administra la carpeta completa. Caja/Ventas únicamente puede
      // aplicar pagos y actualizar el estado financiero derivado del cobro.
      allow update: if
        canCredits()
        || (
          canSales()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "cuotas",
            "saldo",
            "abonos",
            "estado",
            "actualizadoEn",
            "actualizadoPor",
            "historial",
            "canceladoEn",
            "canceladaPorFacturaId"
          ])
        );
    }

    match /productos/{productId} {
      allow read: if isActiveUser();

      // El catálogo se administra con el permiso Productos. Ventas solo puede
      // tocar las cantidades necesarias al confirmar un cobro; no puede
      // modificar SKU, nombre, costo, precio, categoría ni metadatos comerciales.
      allow create: if canProducts();
      allow delete: if isAdmin();

      allow update: if
        canProducts()
        || (
          canSales()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "stock",
            "stockReservado",
            "stockReservas",
            "actualizadoEn",
            "actualizadoPor"
          ])
        )
        || (
          canTickets()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "stockReservado",
            "stockReservas",
            "actualizadoEn",
            "actualizadoPor"
          ])
        );
    }

    // Libro mayor de inventario. Los movimientos se crean desde Catálogo/Stock
    // o como consecuencia de una venta confirmada en Caja. Una vez registrados
    // son inmutables: las correcciones se realizan mediante otro movimiento.
    match /stock_movimientos/{movementId} {
      allow read: if isActiveUser();
      allow create: if
        canProducts()
        || (
          canSales()
          && request.resource.data.tipo == "Salida"
          && request.resource.data.cantidad < 0
          && request.resource.data.facturaId is string
          && existsAfter(/databases/$(database)/documents/facturas/$(request.resource.data.facturaId))
        )
        || (
          (canTickets() || canSales())
          && request.resource.data.tipo in ["Reserva", "Liberación"]
          && request.resource.data.origen in ["Ticket", "Presupuesto"]
        );
      allow update, delete: if false;
    }

    match /promociones/{promotionId} {
      allow read: if isActiveUser();
      allow create, update: if canProducts();
      allow delete: if isAdmin();
    }

    match /crm/{opportunityId} {
      allow read: if canSales();
      allow create, update: if canSales();
      allow delete: if isAdmin();
    }

    /* =====================================
       CAJA / FACTURACIÓN
    ===================================== */

    match /ventas/{saleId} {
      allow read: if canSales() || canReports();
      allow create: if canSales();

      // Una venta confirmada es histórica. Ventas solo puede reflejar
      // anulaciones/cancelaciones provenientes del comprobante asociado.
      allow update: if
        canSales()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "estado",
          "estadoPago",
          "notaCreditoId",
          "montoReintegrado",
          "actualizadoEn"
        ]);

      allow delete: if false;
    }

    match /facturas/{invoiceId} {
      allow read: if canSales() || canCredits() || canReports();

      // Las NC generadas desde Auditoría interna solo pueden ser creadas
      // por administrador. El resto de los comprobantes conserva el flujo
      // comercial habitual de Ventas.
      allow create: if
        isAdmin()
        || (
          canSales()
          && (
            !request.resource.data.keys().hasAny(["origenAuditoria"])
            || request.resource.data.origenAuditoria != true
          )
        );

      allow delete: if false;

      // Una factura emitida no puede editar libremente sus importes, cliente,
      // ítems, numeración ni datos fiscales. Ventas solo modifica campos de
      // estado/auditoría usados por NC, cancelación, rectificación o cobro.
      // El administrador conserva la vía especial de Auditoría interna.
      allow update: if
        isAdmin()
        || (
          canSales()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "estado",
            "estadoPago",
            "notaCreditoId",
            "anuladaEn",
            "canceladaEn",
            "ultimaRectificacion",
            "rectificadoEn",
            "montoCobrado",
            "saldoPendiente",
            "pagadoEn",
            "actualizadoEn",
            "historial"
          ])
        )
        || (
          canCredits()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "estadoPago",
            "montoCobrado",
            "saldoPendiente",
            "pagadoEn",
            "actualizadoEn",
            "historial"
          ])
        );
    }

    match /caja_pendientes/{pendingId} {
      allow read: if hasAnyPermission([
        "Ver y actualizar tickets asignados",
        "Registrar ventas y cobros",
        "Abrir y cerrar corte de caja",
        "Aprobar créditos y descuentos",
        "Ver reportes financieros"
      ]);

      // Ventas puede gestionar cualquier pendiente. Tickets y Créditos solo
      // crean/retiran pendientes correspondientes a su propio flujo.
      allow create: if
        canSales()
        || (
          canTickets()
          && request.resource.data.origen == "Ticket"
          && request.resource.data.ticketId != null
        )
        || (
          canCredits()
          && request.resource.data.origen == "Crédito"
          && request.resource.data.creditoId != null
        );

      allow update: if false;

      allow delete: if
        canSales()
        || (
          canTickets()
          && resource.data.origen == "Ticket"
          && resource.data.ticketId != null
        )
        || (
          canCredits()
          && resource.data.origen == "Crédito"
          && resource.data.creditoId != null
        );
    }

    match /caja_cortes/{cutId} {
      allow read: if canCash() || canSales() || canReports();
      allow create: if canCash();
      allow update, delete: if false;
    }

    match /cuenta_corriente/{movementId} {
      allow read: if canSales() || canCredits() || canReports();

      // Libro de movimientos append-only: una corrección genera un nuevo
      // asiento compensatorio, nunca reescribe el movimiento histórico.
      allow create: if canSales() || canCredits() || isAdmin();
      allow update, delete: if false;
    }

    /* =====================================
       AUDITORÍA INTERNA DE CLIENTES
       - inmutable desde la aplicación
       - solo administrador puede leer/crear
    ===================================== */

    match /auditoria_clientes/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    /* =====================================
       NEGOCIO / CONTADORES / CAJA ACTIVA
    ===================================== */

    match /negocio/configuracion {
      allow read: if isActiveUser();
      allow write: if canSecurity();
    }

    match /negocio/contadores {
      allow read: if isActiveUser();

      // Cada módulo solo puede tocar sus propios consecutivos. Esto evita
      // que un perfil de Tickets altere numeración de Facturas/Ventas, o
      // viceversa. NDA queda reservado a Auditoría interna (administrador).
      allow create: if
        isAdmin()
        || (
          canTickets()
          && request.resource.data.keys().hasOnly([
            "tickets",
            "presupuestos"
          ])
        )
        || (
          canSales()
          && request.resource.data.keys().hasOnly([
            "presupuestos",
            "ventas",
            "facturas",
            "nc"
          ])
        );

      allow update: if
        isAdmin()
        || (
          canTickets()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "tickets",
            "presupuestos"
          ])
        )
        || (
          canSales()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "presupuestos",
            "ventas",
            "facturas",
            "nc"
          ])
        );

      allow delete: if false;
    }

    match /negocio/caja_activa {
      allow read: if hasAnyPermission([
        "Registrar ventas y cobros",
        "Abrir y cerrar corte de caja",
        "Aprobar créditos y descuentos",
        "Ver reportes financieros"
      ]);

      // Caja puede administrar la sesión/fondo. Ventas y Créditos únicamente
      // agregan movimientos y actualizan la marca temporal derivada del cobro.
      allow create: if
        canCash()
        || (
          (canSales() || canCredits())
          && request.resource.data.keys().hasOnly([
            "movs",
            "actualizadoEn"
          ])
        );

      allow update: if
        canCash()
        || (
          (canSales() || canCredits())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "movs",
            "actualizadoEn"
          ])
        );

      allow delete: if false;
    }

    match /negocio/{documentId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    /* =====================================
       TODO LO NO DECLARADO: DENEGADO
    ===================================== */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
